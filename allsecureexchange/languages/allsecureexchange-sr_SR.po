msgstr "KONFIGURACIONA GREŠKA. The XML you provided was malformed or invalid"

#: classes/includes/allsecure-exchange-error-list.php:12
msgid "CONFIG ERROR. Preconditions failed, e.g. capture on a failed authorize"
msgstr ""
"KONFIGURACIONA GREŠKA. Preconditions failed, e.g. capture on a failed "
"authorize"

#: classes/includes/allsecure-exchange-error-list.php:13
msgid ""
"CONFIG ERROR. Something is wrong your configuration, please contact your "
"integration engineer"
msgstr ""
"KONFIGURACIONA GREŠKA. Something is wrong your configuration, please contact "
"your integration engineer"

#: classes/includes/allsecure-exchange-error-list.php:14
msgid "CONFIG ERROR. Unexpected system error"
msgstr "KONFIGURACIONA GREŠKA. Unexpected system error"

#: classes/includes/allsecure-exchange-error-list.php:15
msgid ""
"CONFIG ERROR. We received an error which is not (yet) mapped to a better "
"error code"
msgstr ""
"KONFIGURACIONA GREŠKA. We received an error which is not (yet) mapped to a "
"better error code"

#: classes/includes/allsecure-exchange-error-list.php:16
msgid ""
"Account closed. The customer cancelled permission for his payment instrument "
"externally"
msgstr ""
"Kartica koju ste uneli ne može biti prihvacena. Molimo pokušajte drugom "
"karticom"

#: classes/includes/allsecure-exchange-error-list.php:17
msgid "User cancelled. Transaction was cancelled by customer"
msgstr "Transakcija je otkazana od strane kupca"

#: classes/includes/allsecure-exchange-error-list.php:18
msgid "Transaction declined. Please try again later or change the card"
msgstr "Vaša transakcija nije odobrena. Pokušajte ponovo ili promenite karticu"

#: classes/includes/allsecure-exchange-error-list.php:19
msgid "Quota regulation. Card limit reached"
msgstr ""
"Kartica koju ste uneli je premašila limit. Molimo izaberite drugu karticu"

#: classes/includes/allsecure-exchange-error-list.php:20
msgid "Transaction expired. Customer took to long to submit his payment info"
msgstr "Korisnik nije u predviđenom roku završio transakciju"

#: classes/includes/allsecure-exchange-error-list.php:21
msgid "Insufficient funds. Card limit reached"
msgstr ""
"Kartica koju ste uneli je premašila limit. Molimo izaberite drugu karticu"

#: classes/includes/allsecure-exchange-error-list.php:22
msgid "Incorrect payment info. Double check and try again"
msgstr ""
"Uneti podaci o platnoj kartici nisu tacni. Proverite podatke i pokušajte "
"ponovo"

#: classes/includes/allsecure-exchange-error-list.php:23
msgid "Invalid card. Try with some other card"
msgstr ""
"Kartica koju ste uneli ne može biti prihvacena. Molimo pokušajte drugom "
"karticom"

#: classes/includes/allsecure-exchange-error-list.php:24
msgid "Expired card. Try with some other card"
msgstr "Kartica koju ste uneli je istekla. Molimo izaberite drugu karticu"

#: classes/includes/allsecure-exchange-error-list.php:25
msgid "Invalid card. Call your bank immediately"
msgstr ""
"Vaša transakcija nije odobrena. Molimo proverite sa bankom koja vam je "
"izdala karticu"

#: classes/includes/allsecure-exchange-error-list.php:26
msgid "Unsupported card. Try with some other card"
msgstr ""
"Kartica koju ste uneli ne može biti prihvacena. Molimo pokušajte drugom "
"karticom"

#: classes/includes/allsecure-exchange-error-list.php:27
msgid "Transaction cancelled"
msgstr "Transakcija je otkazana"

#: classes/includes/allsecure-exchange-error-list.php:28
#: classes/includes/allsecure-exchange-error-list.php:29
#: classes/includes/allsecure-exchange-error-list.php:30
#: classes/includes/allsecure-exchange-error-list.php:31
msgid "Transaction declined. Please try again later or call your bank"
msgstr ""
"Vaša transakcija nije odobrena. Molimo izaberite drugu karticu ili proverite "
"sa bankom koja vam je izdala karticu"

#: classes/includes/allsecure-exchange-error-list.php:32
msgid "Invalid IBAN. Double check and try again"
msgstr "IBAN nije validan. Proverite podatke i pokušajte ponovo"

#: classes/includes/allsecure-exchange-error-list.php:33
msgid "Invalid BIC. Double check and try again"
msgstr "BIC nije validan. Proverite podatke i pokušajte ponovo"

#: classes/includes/allsecure-exchange-error-list.php:34
msgid "Customer data invalid. Double check and try again"
msgstr "Podaci o korisniku nisu validni. Proverite podatke i pokušajte ponovo"

#: classes/includes/allsecure-exchange-error-list.php:35
msgid "CVV required. Double check and try again"
msgstr "CVV kod je obavezan. Proverite podatke i pokušajte ponovo"

#: classes/includes/allsecure-exchange-error-list.php:36
msgid ""
"3D-Secure Verification failed. Please call your bank or try with a non 3-D "
"Secure card"
msgstr ""
"Vaša 3D Secure autentifikacija nije uspela. Molimo pozovite banku koja vam "
"je izdala karticu ili koristite karticu koja nije 3D-Secure"

#: classes/includes/allsecure-exchange-error-list.php:37
msgid "COMMUNICATION PROBLEM. Timeout. Try again after a short pause"
msgstr ""
"KOMUNIKACIJA: Transakcija je istekla. Napravite pauzu i pokušajte nešto "
"kasnije"

#: classes/includes/allsecure-exchange-error-list.php:38
msgid "COMMUNICATION PROBLEM. Transaction not allowed"
msgstr "KOMUNIKACIJA: Transakcija nije dozvoljena"

#: classes/includes/allsecure-exchange-error-list.php:39
msgid ""
"COMMUNICATION PROBLEM. System temporary unavailable. Try again after a short "
"pause"
msgstr ""
"KOMUNIKACIJA: Sistem privremeno nedostupan. Napravite pauzu i pokušajte "
"nešto kasnije"

#: classes/includes/allsecure-exchange-error-list.php:40
msgid "Duplicate transaction ID"
msgstr "ID Transakcije već korišćen"

#: classes/includes/allsecure-exchange-error-list.php:41
msgid "COMMUNICATION PROBLEM. Try again after a short pause"
msgstr ""
"KOMUNIKACIJA: Problem u konekciji sa bankom. Napravite pauzu i pokušajte "
"nešto kasnije"

#: classes/includes/allsecure-exchange-error-list.php:42
msgid "Schedule request is invalid"
msgstr "Zahtev za planiranjem transakcije nije validan"

#: classes/includes/allsecure-exchange-error-list.php:43
msgid "Schedule request failed"
msgstr "Zahtev za planiranjem transakcije nije prihvaćen"

#: classes/includes/allsecure-exchange-error-list.php:44
msgid "Schedule action is not valid"
msgstr "Planirana transakcija nije validna"

#: classes/includes/allsecure-exchange-error-list.php:45
msgid "RegistrationId is required"
msgstr "RegistrationId je neophodan"

#: classes/includes/allsecure-exchange-error-list.php:46
msgid "RegistrationId is not valid"
msgstr "RegistrationId nije validan"

#: classes/includes/allsecure-exchange-error-list.php:47
msgid ""
"The registrationId must point to a \"register\", \"debit+register\" or "
"\"preuth+register\""
msgstr "RegistrationId nema odgovarajuću referencu"

#: classes/includes/allsecure-exchange-error-list.php:48
msgid ""
"Initial transaction is not a \"register\", \"debit+register\" or \"preuth"
"+register\""
msgstr ""
"Inicijalna transakcija kojom započinju planirana ponavljajuća plaćanja mora "
"biti \"register\", \"debit+register\" ili \"preuth+register\""

#: classes/includes/allsecure-exchange-error-list.php:49
msgid ""
"The period between the initial and second transaction must be greater than "
"24 hours"
msgstr ""
"Period između inicijalne i sledeće transakcije mora biti duži od 24 sata"

#: classes/includes/allsecure-exchange-error-list.php:50
msgid "The scheduleId is not valid or does not match to the connector"
msgstr ""
"ScheduleId (id planirane transakcije) nije validan ili nije povezan na ovaj "
"kanal plaćanja"

#: classes/includes/allsecure-exchange-error-list.php:51
msgid "The startDateTime is invalid or older than 24 hours"
msgstr ""
"Planirana početna transakcija (startDateTime) nije validnog formata ili je "
"starija od 24h"

#: classes/includes/allsecure-exchange-error-list.php:52
msgid "The continueDateTime is invalid or older than 24 hours"
msgstr ""
"Planirana naredna transakcija (continueDateTime ) nije validnog formata ili "
"je starija od 24h"

#: classes/includes/allsecure-exchange-error-list.php:53
msgid "The status of the schedule is not valid for the requested operation"
msgstr ""
"Status planirane transakcije nije validnog formata za zahtevanu operaciju"

